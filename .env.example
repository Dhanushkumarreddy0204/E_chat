# ==========================================
# EChat Docker Compose & Application Configuration
# ==========================================

# MongoDB Atlas Connection
# Replace <db_username>, <db_password>, and <cluster-address> with your Atlas details.
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=EChatCluster

# Authentication Secret (Generate a secure random key for production)
SECRET_KEY=change-this-to-a-secure-random-jwt-secret-in-production

# Service URLs
BACKEND_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

