# ==========================================
# EChat Backend Environment Configuration
# ==========================================

PROJECT_NAME=EChat
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------
# MongoDB Atlas Connection
# ------------------------------------------
# Replace <db_username> and <db_password> with your MongoDB Atlas database user credentials.
# Ensure your IP is whitelisted under Network Access in MongoDB Atlas (or 0.0.0.0/0 for anywhere).
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@echatcluster.lkhvkjw.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=EChatCluster

# ------------------------------------------
# Service & Media URLs
# ------------------------------------------
BACKEND_URL=http://localhost:8000
UPLOAD_DIR=uploads

# ------------------------------------------
# CORS Configuration (Comma-separated origins)
# ------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
